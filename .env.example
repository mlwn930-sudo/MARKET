# Copy to .env.local and fill in. Every key here is free.
#
# The scheduled GitHub Actions run does NOT read this file — it reads
# repository secrets. A key set in one place is not set in the other, which
# is the single most common reason a feature works locally and not on the
# deployed site, or the other way round.
#
#   Local:  .env.local
#   CI:     Settings > Secrets and variables > Actions

# Live quotes, the trade stream, company profiles and the news wire.
# https://finnhub.io/register  ·  free tier, 60 calls/minute
FINNHUB_API_KEY=

# SEC requires a real contact in the User-Agent header. Without it EDGAR
# returns "Undeclared Automated Tool" and blocks the request.
# Format: "Name email@example.com"
SEC_USER_AGENT=

# Every language-model feature on the site runs on this one key: the Hebrew
# analysis of each article through the three lenses, the chat at /chat, deep
# research at /research, the daily brief at /brief, and the "analyse this
# story" button on a news card.
#
# Nothing else depends on it. Without it the figures, the metrics, the Core
# Test, the thesis, the screener, the map and the comparison all work
# exactly as before — the pages that need a model say so on the page.
#
# https://aistudio.google.com/apikey  ·  free, no credit card
GEMINI_API_KEY=

# Optional. The model used for all of the above. Defaults to
# gemini-flash-latest, which is what the free tier serves fastest.
GEMINI_MODEL=

# The ten-year Treasury yield, used as the risk-free rate in WACC. Without
# it the site assumes a rate and says so on the page — which is honest but
# means every cost of capital is built on a stated guess.
# https://fredaccount.stlouisfed.org/apikeys  ·  free
FRED_API_KEY=

# Optional. Not used by any page yet.
DATABASE_URL=
