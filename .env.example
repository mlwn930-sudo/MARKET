# Copy to .env.local and fill in. Every key here is free.
#
# The scheduled GitHub Actions run does NOT read this file — it reads
# repository secrets. A key set in one place is not set in the other, which
# is the single most common reason a feature works locally and not on the
# deployed site, or the other way round.
#
#   Local:  .env.local
#   CI:     Settings > Secrets and variables > Actions

# Live quotes, the trade stream, company profiles and the news wire.
# https://finnhub.io/register  ·  free tier, 60 calls/minute
FINNHUB_API_KEY=

# SEC requires a real contact in the User-Agent header. Without it EDGAR
# returns "Undeclared Automated Tool" and blocks the request.
# Format: "Name email@example.com"
SEC_USER_AGENT=

# Every language-model feature on the site runs on this one key: the Hebrew
# analysis of each article through the three lenses, the chat at /chat, deep
# research at /research, the daily brief at /brief, and the "analyse this
# story" button on a news card.
#
# Nothing else depends on it. Without it the figures, the metrics, the Core
# Test, the thesis, the screener, the map and the comparison all work
# exactly as before — the pages that need a model say so on the page.
#
# https://aistudio.google.com/apikey  ·  free, no credit card
GEMINI_API_KEY=

# Optional. The model used for all of the above. Defaults to
# gemini-flash-latest, which is what the free tier serves fastest.
GEMINI_MODEL=

# The ten-year Treasury yield, used as the risk-free rate in WACC. Without
# it the site assumes a rate and says so on the page — which is honest but
# means every cost of capital is built on a stated guess.
# https://fredaccount.stlouisfed.org/apikeys  ·  free
FRED_API_KEY=

# Optional. Not used by any page yet.
DATABASE_URL=

# The published Spline scene for the homepage hero (Financial
# Observatory). Optional: without it the hero renders its drawn SVG
# fallback, which is the guaranteed visual on every device anyway. Publish
# the scene in Spline and paste the .splinecode URL here.
# Format: https://prod.spline.design/<id>/scene.splinecode
NEXT_PUBLIC_SPLINE_SCENE_URL=

# The owner's private build. Empty or absent means the public site: the
# chart reader states no direction, and the Q&A agent refuses an entry,
# a target and a stop, exactly as it does today.
#
# Set to exactly "1" to turn on the stance panel and let the chart agent
# report which way the counted record leans. Anything else — "true",
# "yes", "0", a trailing space — leaves it off, because a mistyped
# variable should fail toward research rather than toward advice.
#
# NEXT_PUBLIC_ is baked in at build time, so this takes effect on the
# next build and not on a dashboard change — a deployment cannot be
# switched between the two modes without rebuilding, which is the point.
# (The private code still ships in a public build as a branch that never
# runs. The flag controls behaviour, not bundle contents.)
NEXT_PUBLIC_PRIVATE_MODE=

# The door. Empty or absent means the site is open to anyone with the
# address, which is how it behaved before the gate existed — and that is
# the deliberate default: a site that locks itself on an unset variable
# locks its owner out on the day he forgets to set it.
#
# Set it and every page, and every API route except the two links that
# appear in alert emails, requires the password once per browser.
#
# NOT NEXT_PUBLIC_. A password inlined into the client bundle is not a
# password.
SITE_PASSWORD=
