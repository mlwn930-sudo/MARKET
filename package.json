{
  "name": "market-intel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "refresh:news": "node --env-file-if-exists=.env.local scripts/refresh-news.mjs",
    "build:fundamentals": "tsx scripts/build-fundamentals.ts",
    "build:institutional": "tsx scripts/build-institutional.ts",
    "summarize:news": "node --env-file-if-exists=.env.local scripts/summarize-news.mjs",
    "filter:news": "node --env-file-if-exists=.env.local scripts/filter-news.mjs",
    "doctor": "node --env-file-if-exists=.env.local scripts/doctor.mjs",
    "build:thesis": "tsx scripts/build-thesis-history.ts",
    "test:scenario": "node --import tsx --test scripts/launch-scenario.test.ts",
    "test:journey": "playwright test",
    "encode:cinema": "node scripts/encode-cinema.mjs",
    "build:logos": "tsx scripts/build-logos.ts",
    "watch": "tsx scripts/watch-market.ts",
    "alerts": "tsx scripts/send-alerts.ts",
    "watch:companies": "tsx scripts/watch-companies.ts",
    "test:hours": "node --import tsx --test scripts/market-hours.test.ts",
    "test:tape": "node --import tsx --test scripts/tape.test.ts",
    "test:template": "node --import tsx --test scripts/template-facts.test.ts",
    "test:correlation": "node --import tsx --test scripts/correlation.test.ts",
    "build:baserates": "tsx scripts/build-base-rates.ts",
    "build:ranks": "tsx scripts/build-ranks.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@splinetool/runtime": "^2.0.58",
    "drizzle-orm": "^0.38.3",
    "fast-xml-parser": "^5.11.1",
    "gsap": "^3.15.0",
    "lightweight-charts": "^5.2.1",
    "motion": "^13.4.2",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "three": "^0.186.1",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^18.0.2",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
